# ─────────────────────────────────────────────────────────────────────────────
# Onco Sphere Backend — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/cancer_institute

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=HELIX Oncology Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development   # development | production

# ── Email (Resend HTTPS API) ──────────────────────────────────────────────────
#
# Onco Sphere uses Resend (https://resend.com) to send emails via HTTPS.
# This avoids SMTP port blocks on Render Free and other restricted environments.
#
# Setup steps:
#   1. Create a free account at https://resend.com
#   2. Add and verify your sender domain under "Domains"
#   3. Generate an API key under "API Keys" (keep it secret — never commit it)
#   4. Set EMAIL_FROM to an address on your verified domain
#      e.g. noreply@yourdomain.com
#   5. In Render: add all variables below under Environment > Environment Variables
#
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Onco Sphere
EMAIL_REPLY_TO=                         # Optional — leave blank to omit reply-to header
SUPER_ADMIN_EMAIL=admin@yourdomain.com  # Receives new researcher application alerts

# Frontend base URL (used in email CTA links)
FRONTEND_URL=http://localhost:5173

# ── Email Subjects (optional — defaults shown) ────────────────────────────────
# Uncomment and edit to customise subject lines without touching code.
# EMAIL_SUBJECT_REGISTRATION=Application Received — Onco Sphere Research Office
# EMAIL_SUBJECT_OTP=Your Onco Sphere Draft Resume Verification Code
# EMAIL_SUBJECT_APPROVED=Congratulations! Your Onco Sphere Access Has Been Approved
# EMAIL_SUBJECT_REJECTED=Update: Your Onco Sphere Access Request
# EMAIL_SUBJECT_PASSWORD_RESET=Password Reset Verification Code — Onco Sphere
# EMAIL_SUBJECT_ADMIN_NEW_APPLICATION=New Researcher Application Pending Review

# ── Email Retry Config (optional — defaults shown) ────────────────────────────
# EMAIL_MAX_RETRIES=3
# EMAIL_RETRY_BASE_DELAY=1.0
