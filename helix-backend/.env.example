# ─────────────────────────────────────────────────────────────────────────────
# Onco Sphere Backend — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/cancer_institute

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=HELIX Oncology Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development   # development | production

# ── Email / SMTP ──────────────────────────────────────────────────────────────
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Use the 16-character app password below (no spaces)
#
# Outlook / Office 365 setup:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#
# Custom SMTP server:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587  (TLS) or 465 (SSL)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-sender-email@gmail.com
EMAIL_FROM_NAME=Onco Sphere

# Frontend base URL (used in email CTA links)
FRONTEND_URL=http://localhost:5173

# ── Email Subjects (optional — defaults shown) ────────────────────────────────
# Uncomment and edit to customise subject lines without touching code.
# EMAIL_SUBJECT_REGISTRATION=Application Received — Onco Sphere Research Office
# EMAIL_SUBJECT_OTP=Your Onco Sphere Draft Resume Verification Code
# EMAIL_SUBJECT_APPROVED=Congratulations! Your Onco Sphere Access Has Been Approved
# EMAIL_SUBJECT_REJECTED=Update: Your Onco Sphere Access Request

# ── Email Retry Config (optional — defaults shown) ────────────────────────────
# EMAIL_MAX_RETRIES=3
# EMAIL_RETRY_BASE_DELAY=1.0
